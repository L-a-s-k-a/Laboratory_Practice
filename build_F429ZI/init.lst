  38:Core/Src/init.c ****     //第一步：启用GPIO时钟 
  39:Core/Src/init.c **** 
  40:Core/Src/init.c ****     volatile uint32_t *rcc_ahb1enr = (volatile uint32_t *)(RCC_BASE_ADDR + AHB1ENR_OFFSET);
  41:Core/Src/init.c ****     // 设置GPIOB、GPIOD、GPIOG的时钟使能位（bit1、bit3、bit6）
  42:Core/Src/init.c ****     *rcc_ahb1enr |= (1 << 1) | (1 << 3) | (1 << 6);  // 使能GPIOB、GPIOD、GPIOG时钟
  43:Core/Src/init.c **** 
  44:Core/Src/init.c ****     //第二步：配置PD4为输入模式+上拉（正常模式，避免引脚浮空）
  45:Core/Src/init.c ****     PD4_Set_Input_PullUp();
  46:Core/Src/init.c **** 
  47:Core/Src/init.c ****     //第三步：配置PG3为输入模式（按键引脚，启用内部上拉）
  48:Core/Src/init.c ****     volatile uint32_t *pg3_moder = (volatile uint32_t *)(GPIOG_BASE_ADDR + MODER_OFFSET);
  49:Core/Src/init.c ****     volatile uint32_t *pg3_pupdr = (volatile uint32_t *)(GPIOG_BASE_ADDR + PUPDR_OFFSET);
  50:Core/Src/init.c ****     // 配置PG3引脚模式：清除原来的设置，设置为输入模式(00)
  51:Core/Src/init.c ****     *pg3_moder &= ~(3 << (3 * 2));       // 设置PG3为输入模式
  52:Core/Src/init.c ****     // 配置PG3上拉下拉：先清除原来的设置，再设置为上拉模式(01)
  53:Core/Src/init.c ****     *pg3_pupdr = (*pg3_pupdr & ~(3 << (3 * 2))) | (1 << (3 * 2));  // 设置PG3内部上拉电阻
  54:Core/Src/init.c **** 
  55:Core/Src/init.c ****     //第四步：配置PB14 (LED2) - 初始为低电平（LED熄灭）
  56:Core/Src/init.c ****     volatile uint32_t *pb14_moder = (volatile uint32_t *)(GPIOB_BASE_ADDR + MODER_OFFSET);
  57:Core/Src/init.c ****     volatile uint32_t *pb14_otyper = (volatile uint32_t *)(GPIOB_BASE_ADDR + OTYPER_OFFSET);
