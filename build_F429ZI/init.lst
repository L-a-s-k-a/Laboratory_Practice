  59:Core/Src/init.c ****     volatile uint32_t *pb14_pupdr = (volatile uint32_t *)(GPIOB_BASE_ADDR + PUPDR_OFFSET);
  60:Core/Src/init.c ****     volatile uint32_t *pb14_bsrr = (volatile uint32_t *)(GPIOB_BASE_ADDR + BSRR_OFFSET);
  61:Core/Src/init.c **** 
  62:Core/Src/init.c ****     // 配置PB14引脚模式：先清除原来的设置，再设置为输出模式(01)
  63:Core/Src/init.c ****     *pb14_moder = (*pb14_moder & ~(3 << (14 * 2))) | (1 << (14 * 2));      // 设置PB14为通用�
  64:Core/Src/init.c ****     // 配置PB14输出类型：清除第14位，设置为推挽输出(0)
  65:Core/Src/init.c ****     *pb14_otyper &= ~(1 << 14);                                            // 设置PB14为推挽�
  66:Core/Src/init.c ****     // 配置PB14输出速度：先清除原来的设置，再设置为高速模式(10)
  67:Core/Src/init.c ****     *pb14_ospeedr = (*pb14_ospeedr & ~(3 << (14 * 2))) | (2 << (14 * 2));  // 设置PB14为高速�
  68:Core/Src/init.c ****     // 配置PB14上拉下拉：清除第14位的上下拉设置，设置为无上下拉(00)
  69:Core/Src/init.c ****     *pb14_pupdr &= ~(3 << (14 * 2));                                       // 禁用PB14内部上�
  70:Core/Src/init.c ****     // 设置PB14初始输出低电平（LED熄灭）
  71:Core/Src/init.c ****     *pb14_bsrr = (1U << (14 + 16U));                                       // PB14输出低电平
  72:Core/Src/init.c **** 
  73:Core/Src/init.c ****     // 第五步：配置PB7 (LED3)使用自定义宏 - 初始为低电平（LED熄灭）
  74:Core/Src/init.c ****     PB7_MODER_OUTPUT();        // 宏：设置PB7为输出模式
  75:Core/Src/init.c ****     PB7_OTYPER_PUSHPULL();     // 宏：设置PB7为推挽输出
  76:Core/Src/init.c ****     PB7_OSPEEDR_HIGH();        // 宏：设置PB7为高速模式
  77:Core/Src/init.c ****     PB7_PUPDR_NOPULL();        // 宏：禁用PB7内部上下拉电阻
  78:Core/Src/init.c ****     PB7_LED_OFF();             // 宏：PB7输出低电平（LED熄灭）
  79:Core/Src/init.c **** 
  80:Core/Src/init.c ****     // 第六步：配置PB0 (LED4) - 使用真正的直接内存访问，初始为低电平（LED�
  81:Core/Src/init.c ****     volatile uint32_t *pb0_moder = (volatile uint32_t *)(GPIOB_BASE_ADDR + MODER_OFFSET);
  82:Core/Src/init.c ****     volatile uint32_t *pb0_otyper = (volatile uint32_t *)(GPIOB_BASE_ADDR + OTYPER_OFFSET);
