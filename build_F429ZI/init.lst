   8:Core/Src/init.c ****     // STEP 1: ENABLE CLOCKS FOR GPIO PORTS
   9:Core/Src/init.c ****     // ==========================================================================
  10:Core/Src/init.c ****     // Microcontroller needs clock signals to make GPIO ports work
  11:Core/Src/init.c ****     // RCC->AHB1ENR controls clocks for GPIO ports B and C
  12:Core/Src/init.c ****     // RCC_AHB1ENR_GPIOBEN enables clock for GPIO Port B (where LEDs are)
  13:Core/Src/init.c ****     // RCC_AHB1ENR_GPIOCEN enables clock for GPIO Port C (where buttons are)
  14:Core/Src/init.c ****     SET_BIT(RCC->AHB1ENR, RCC_AHB1ENR_GPIOBEN | RCC_AHB1ENR_GPIOCEN);
