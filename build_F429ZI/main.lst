   1:Core/Src/main.c **** #include "stm32f4xx.h"
   2:Core/Src/main.c **** 
   3:Core/Src/main.c **** /*
   4:Core/Src/main.c ****  * Variant 10, extra task: blinking LEDs without hardware timers
   5:Core/Src/main.c ****  *   LED1 - PB0  (green, board)  - direct memory access
   6:Core/Src/main.c ****  *   LED2 - PB7  (blue, board)   - custom defines
   7:Core/Src/main.c ****  *   LED3 - PB14 (red, board)    - CMSIS
   8:Core/Src/main.c ****  *   LED4 - PA5  (D13, external) - CMSIS
   9:Core/Src/main.c ****  *   LED5 - PA6  (D12, external) - CMSIS
  10:Core/Src/main.c ****  *   LED6 - PA7  (D11, external) - CMSIS
  11:Core/Src/main.c ****  *   Button 1 - PC13 (board B1): blinking frequency UP   (3 levels)
  12:Core/Src/main.c ****  *   Button 2 - PA3  (A0, HW-483): blinking frequency DOWN (3 levels)
  13:Core/Src/main.c ****  *   Button 3 - PC0  (A1):
  14:Core/Src/main.c ****  *       short press - mode ON: turns on the next LED (up to 6)
  15:Core/Src/main.c ****  *                     mode OFF: turns off one LED
  16:Core/Src/main.c ****  *       hold        - switches the mode ON <-> OFF (once per hold)
  17:Core/Src/main.c ****  *
  18:Core/Src/main.c ****  * Time is counted in main loop ticks (about 1 ms each, busy-wait delay).
  19:Core/Src/main.c ****  * If blinking is too fast or too slow, change TICK_LOOPS.
  20:Core/Src/main.c ****  * Do not hold the buttons while powering the board.
  21:Core/Src/main.c ****  */
  22:Core/Src/main.c **** 
  23:Core/Src/main.c **** /* ---- Custom defines for LED2 (PB7) ---- */
  24:Core/Src/main.c **** #define MY_GPIOB_MODER          (*(volatile uint32_t*)(0x40020400UL + 0x00UL))
  25:Core/Src/main.c **** #define MY_GPIOB_OTYPER         (*(volatile uint32_t*)(0x40020400UL + 0x04UL))
  26:Core/Src/main.c **** #define MY_GPIOB_OSPEEDR        (*(volatile uint32_t*)(0x40020400UL + 0x08UL))
  27:Core/Src/main.c **** #define MY_GPIOB_PUPDR          (*(volatile uint32_t*)(0x40020400UL + 0x0CUL))
  28:Core/Src/main.c **** #define MY_GPIOB_BSRR           (*(volatile uint32_t*)(0x40020400UL + 0x18UL))
  29:Core/Src/main.c **** 
  30:Core/Src/main.c **** #define MY_PIN7_MODE_OUT        0x00004000UL
ARM GAS  C:\Users\87A0~1\AppData\Local\Temp\cc9X7Bna.s 			page 2


  31:Core/Src/main.c **** #define MY_PIN7_OTYPE_PP_MASK   0xFFFFFF7FUL
  32:Core/Src/main.c **** #define MY_PIN7_OSPEED_MID      0x00004000UL
  33:Core/Src/main.c **** #define MY_PIN7_PUPDR_NONE_MASK 0xFFFF3FFFUL
  34:Core/Src/main.c **** #define MY_PIN7_SET             0x00000080UL
  35:Core/Src/main.c **** #define MY_PIN7_RESET           0x00800000UL
  36:Core/Src/main.c **** 
  37:Core/Src/main.c **** #define MY_SET_BITS(REG, MASK)  ((REG) |= (MASK))
  38:Core/Src/main.c **** #define MY_CLR_BITS(REG, MASK)  ((REG) &= (MASK))
  39:Core/Src/main.c **** 
  40:Core/Src/main.c **** /* ---- Settings ---- */
  41:Core/Src/main.c **** #define LEDS_COUNT          6U
  42:Core/Src/main.c **** #define TICK_LOOPS          2000UL    /* one tick, about 1 ms at 16 MHz */
  43:Core/Src/main.c **** #define DEBOUNCE_TICKS      20U       /* press is accepted after 20 ticks */
  44:Core/Src/main.c **** #define HOLD_START_TICKS    600U      /* hold button 3 this long to switch the mode */
  45:Core/Src/main.c **** 
  46:Core/Src/main.c **** /* Half-period of blinking for levels 1, 2, 3 (in ticks): about 1, 2, 4 Hz */
  47:Core/Src/main.c **** static const uint16_t half_period[3] = {500U, 250U, 125U};
  48:Core/Src/main.c **** 
  49:Core/Src/main.c **** /* Variables for STMViewer */
  50:Core/Src/main.c **** volatile uint8_t flag        = 0;   /* 1 while any button is pressed */
  51:Core/Src/main.c **** volatile uint8_t freq_level  = 1;   /* blinking frequency level (1..3) */
  52:Core/Src/main.c **** volatile uint8_t leds_on     = 1;   /* how many LEDs take part in blinking */
  53:Core/Src/main.c **** volatile uint8_t blink_state = 1;   /* 1 - LEDs are lit now, 0 - dark */
  54:Core/Src/main.c **** volatile uint8_t btn3_mode   = 0;   /* 0 - button 3 adds LEDs, 1 - removes */
  55:Core/Src/main.c **** 
  56:Core/Src/main.c **** static uint8_t  btn_idle[3] = {0, 0, 0};
  57:Core/Src/main.c **** static uint16_t held[3]     = {0, 0, 0};
  58:Core/Src/main.c **** static uint16_t blink_cnt   = 0;
