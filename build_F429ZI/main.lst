  49:Core/Src/main.c **** volatile uint8_t freq1_index = 0U; // 0..2, индекс частоты режима 1
  50:Core/Src/main.c **** 
  51:Core/Src/main.c **** /* Частоты для режима 1: 0.5 Гц, 1.7 Гц, 2.2 Гц
  52:Core/Src/main.c ****  * Храним период переключения пары (T) в мс
  53:Core/Src/main.c ****  * 0.5 Гц → T = 2000 мс
  54:Core/Src/main.c ****  * 1.7 Гц → T ≈ 588 мс
  55:Core/Src/main.c ****  * 2.2 Гц → T ≈ 455 мс
  56:Core/Src/main.c ****  */
  57:Core/Src/main.c **** static const uint32_t mode1_intervals_ms[3] = {2000U, 588U, 455U};
  58:Core/Src/main.c **** volatile uint32_t last_pair_switch_ms = 0U;
  59:Core/Src/main.c **** 
  60:Core/Src/main.c **** /* --------------------- Режим 2 (индивидуальное мерцание) -------------
  61:Core/Src/main.c **** 
  62:Core/Src/main.c **** /*
  63:Core/Src/main.c ****  * Для каждого светодиода храним:
  64:Core/Src/main.c ****  *  freq2_index[i] — индекс частоты 0..2
  65:Core/Src/main.c ****  *  last_toggle_ms[i] — момент последнего переключения состоян
  66:Core/Src/main.c ****  *  led_state[i] — 0 = выключен, 1 = включен
  67:Core/Src/main.c ****  *
  68:Core/Src/main.c ****  * Частоты: 0.3 Гц, 0.8 Гц, 1.4 Гц
  69:Core/Src/main.c ****  * Храним полупериод (T/2) в мс, т.к. мы "переключаем" (toggle) �
  70:Core/Src/main.c ****  *
  71:Core/Src/main.c ****  * 0.3 Гц → T ≈ 3333 мс → T/2 ≈ 1666 мс
  72:Core/Src/main.c ****  * 0.8 Гц → T = 1250 мс → T/2 = 625 мс
  73:Core/Src/main.c ****  * 1.4 Гц → T ≈ 714 мс → T/2 ≈ 357 мс
  74:Core/Src/main.c ****  */
  75:Core/Src/main.c **** volatile uint8_t selected_led = 0U; // какой LED сейчас настраиваем (0..5)
  76:Core/Src/main.c **** volatile uint8_t freq2_index[LED_COUNT] = {0U, 0U, 0U, 0U, 0U, 0U};
  77:Core/Src/main.c **** volatile uint32_t last_toggle_ms[LED_COUNT] = {0U};
  78:Core/Src/main.c **** volatile uint8_t led_state[LED_COUNT] = {0U}; // текущее состояние LED (для ре
  79:Core/Src/main.c **** 
  80:Core/Src/main.c **** static const uint32_t mode2_intervals_ms[3] = {1666U, 625U, 357U};
