 115:CMSIS/Devices/STM32F7xx/Src/system_stm32f7xx.c **** 
 116:CMSIS/Devices/STM32F7xx/Src/system_stm32f7xx.c ****   /* This variable is updated in three ways:
 117:CMSIS/Devices/STM32F7xx/Src/system_stm32f7xx.c ****       1) by calling CMSIS function SystemCoreClockUpdate()
 118:CMSIS/Devices/STM32F7xx/Src/system_stm32f7xx.c ****       2) by calling HAL API function HAL_RCC_GetHCLKFreq()
 119:CMSIS/Devices/STM32F7xx/Src/system_stm32f7xx.c ****       3) each time HAL_RCC_ClockConfig() is called to configure the system clock frequency 
 120:CMSIS/Devices/STM32F7xx/Src/system_stm32f7xx.c ****          Note: If you use this function to configure the system clock; then there
 121:CMSIS/Devices/STM32F7xx/Src/system_stm32f7xx.c ****                is no need to call the 2 first functions listed above, since SystemCoreClock
 122:CMSIS/Devices/STM32F7xx/Src/system_stm32f7xx.c ****                variable is updated automatically.
 123:CMSIS/Devices/STM32F7xx/Src/system_stm32f7xx.c ****   */
 124:CMSIS/Devices/STM32F7xx/Src/system_stm32f7xx.c ****   uint32_t SystemCoreClock = 16000000;
 125:CMSIS/Devices/STM32F7xx/Src/system_stm32f7xx.c ****   const uint8_t AHBPrescTable[16] = {0, 0, 0, 0, 0, 0, 0, 0, 1, 2, 3, 4, 6, 7, 8, 9};
 126:CMSIS/Devices/STM32F7xx/Src/system_stm32f7xx.c ****   const uint8_t APBPrescTable[8] = {0, 0, 0, 0, 1, 2, 3, 4};
