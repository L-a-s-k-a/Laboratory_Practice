  56:Core/Src/init.c ****          VCO_out = VCO_in * PLLN = 2 МГц * 200 = 400 МГц
  57:Core/Src/init.c ****          SYSCLK  = VCO_out / PLLP = 400 / 4 = 100 МГц
  58:Core/Src/init.c ****          PLLQ    = 8 → 400 / 8 = 50 МГц
