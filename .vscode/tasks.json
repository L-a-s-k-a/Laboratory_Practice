{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "Сборка Регистры",
      "type": "process",
      "command": "mingw32-make",
      "args": [
        "VARIANT=registers"
      ],
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "problemMatcher": [
        "$gcc"
      ]
    },
    {
      "label": "Сборка Макросы",
      "type": "process",
      "command": "mingw32-make",
      "args": [
        "VARIANT=macros"
      ],
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "problemMatcher": [
        "$gcc"
      ]
    },
    {
      "label": "Сборка CMSIS",
      "type": "process",
      "command": "mingw32-make",
      "args": [
        "VARIANT=cmsis"
      ],
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "problemMatcher": [
        "$gcc"
      ]
    },
    {
      "label": "Сборка всех вариантов",
      "type": "process",
      "command": "mingw32-make",
      "args": [
        "VARIANT=all"
      ],
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "group": {
        "kind": "build",
        "isDefault": true
      },
      "problemMatcher": [
        "$gcc"
      ]
    }
  ]
}
