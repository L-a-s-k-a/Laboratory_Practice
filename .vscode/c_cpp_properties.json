{
    "configurations": [
        {
            // "name": "STM32 F7",
            "name": "STM F4",
            "includePath": [
                "${workspaceFolder}/**",
                "${workspaceFolder}/Core/inc"
            ],
            "defines": [
                "_DEBUG",
                "UNICODE",
                "_UNICODE",
                // "STM32F756xx"
                "STM32F429xx"
            ],
            "compilerPath": "/usr/bin/arm-none-eabi-gcc", //${ARMGCC_PATH}/arm-none-eabi-gcc - for Windows
            "cStandard": "c17",
            "cppStandard": "c++17",
            "intelliSenseMode": "gcc-arm",
            "compilerArgs": [
                // "-mcpu=cortex-m7",
                "-mcpu=cortex-m4",
                "-mthumb"
            ]
        }
    ],
    "version": 4
}